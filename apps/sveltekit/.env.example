# apps/sveltekit — mesma forma do apps/nextjs/.env.example, com a URL desta porta.
# `DATABASE_URL` e relativo ao cwd (`apps/sveltekit`), entao resolve para
# packages/server/prisma/dev.db.
DATABASE_URL="file:../../packages/server/prisma/dev.db"

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Better Auth (gerar secret com: openssl rand -base64 32)
# A URL precisa ser a do app que esta rodando: o BFF e montado aqui, e o
# `environment.ts` do server so usa BETTER_AUTH_URL como fallback.
BETTER_AUTH_URL="http://localhost:5173"
BETTER_AUTH_SECRET=""

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Redis (docker compose up -d)
REDIS_URL="redis://localhost:6379"
