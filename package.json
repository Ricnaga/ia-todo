{
  "name": "ia-task-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ia-task-manager/nextjs dev",
    "build": "pnpm --filter @ia-task-manager/nextjs build",
    "start": "pnpm --filter @ia-task-manager/nextjs start",
    "lint": "pnpm --filter @ia-task-manager/nextjs lint",
    "lint:fix": "pnpm --filter @ia-task-manager/nextjs lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @ia-task-manager/nextjs typecheck",
    "db:generate": "pnpm --filter @ia-task-manager/nextjs db:generate",
    "db:migrate": "pnpm --filter @ia-task-manager/nextjs db:migrate",
    "db:deploy": "pnpm --filter @ia-task-manager/nextjs db:deploy",
    "db:studio": "pnpm --filter @ia-task-manager/nextjs db:studio",
    "prepare": "husky",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "packageManager": "pnpm@11.17.0"
}
