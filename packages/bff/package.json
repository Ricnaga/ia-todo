{
  "name": "@ia-task-manager/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./graphql": "./src/graphql/index.ts"
  },
  "sideEffects": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "codegen": "tsx scripts/build-schema.ts && graphql-codegen --config codegen.ts",
    "codegen:check": "git diff --exit-code -- src/graphql/generated schema.graphql"
  },
  "dependencies": {
    "@ia-task-manager/schemas": "workspace:*",
    "@ia-task-manager/server": "workspace:*",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-scope-auth": "^4.2.1",
    "@pothos/plugin-with-input": "^4.1.5",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@ia-task-manager/tsconfig": "workspace:*",
    "@parcel/watcher-wasm": "^2.6.0",
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
